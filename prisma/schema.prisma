generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x", "linux-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Game {
  id              Int       @id @default(autoincrement())
  title           String
  originalFile    String
  platform        String
  platformLabel   String
  source          String    @default("rom") // "rom" or "steam"
  coverUrl        String?
  screenshotUrls  String? // JSON array stored as string
  igdbId          Int?
  igdbScore       Float?
  metacriticScore Int?
  releaseDate     DateTime?
  genres          String? // JSON array stored as string
  developer       String?
  publisher       String?
  summary         String?
  videoIds        String?   // JSON array of YouTube video IDs
  artworkUrls     String?   // JSON array of artwork image URLs
  franchise       String?   // Franchise/series name (e.g., "Zelda")
  themes          String?   // JSON array of theme strings (e.g., "Horror", "Fantasy")
  aiFunFacts      String?
  aiStory         String?
  aiEnrichedAt    DateTime?
  isFavorite      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  devices         GameDevice[]
  localCoverPath       String?
  localScreenshotPaths String?  // JSON array: ["screenshots/123/0.jpg", ...]
  localArtworkPaths    String?  // JSON array: ["artwork/123/0.jpg", ...]
  syncQueue       SyncQueue[]
  cacheEntries    CacheEntry[]
  deviceFiles     DeviceFile[]

  @@unique([originalFile, platform])
  @@index([platform])
  @@index([title])
}

model WishlistItem {
  id            Int      @id @default(autoincrement())
  title         String
  platform      String
  platformLabel String
  coverUrl      String?
  igdbScore     Float?
  summary       String?
  genres        String?  // JSON array
  screenshots   String?  // JSON array of URLs
  videoIds      String?  // JSON array of YouTube IDs
  developer     String?
  year          Int?
  createdAt     DateTime @default(now())

  @@unique([title, platform])
}

model Platform {
  id        String @id
  label     String
  icon      String @default("")
  color     String @default("#f59e0b")
  gameCount Int    @default(0)
  sortOrder Int    @default(0)
}

model Settings {
  id               Int    @id @default(1)
  igdbClientId     String @default("")
  igdbClientSecret String @default("")
  steamgriddbKey   String @default("")
  openrouterKey    String @default("")
  steamApiKey      String @default("")
  aiLanguage       String @default("en") // "en" or "de"
  romSearchUrl     String @default("https://romsfun.com/roms/{platformLabel}/?q={title}")
  activeDeviceId   Int?
}

model Device {
  id        Int      @id @default(autoincrement())
  name      String
  type      String   @default("custom")
  protocol  String   @default("ssh")
  host      String
  port      Int      @default(22)
  ftps      Boolean  @default(false) // explicit FTPS (AUTH TLS) for the ftp protocol
  user      String
  password  String
  scanPaths String   @default("[]")
  blacklist String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  games     GameDevice[]
  syncQueue SyncQueue[]
  files     DeviceFile[]
  inventory DeviceInventory?
  profile   DeviceProfile?
}

model GameDevice {
  id           Int     @id @default(autoincrement())
  gameId       Int
  deviceId     Int
  // The filename this game actually has ON THIS device. Game.originalFile is the
  // shared "representative" name (and the unique key); this column is what sync
  // /rename must use so multi-device games and .m3u-vs-disc don't cross paths.
  originalFile String?
  game         Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  device       Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([gameId, deviceId])
}

model SyncQueue {
  id        Int      @id @default(autoincrement())
  type      String   // "rename" | "delete"
  deviceId  Int
  gameId    Int
  filePath  String   // full current path on device
  newPath   String?  // full new path (rename only)
  status    String   @default("pending") // "pending" | "applied" | "failed"
  error     String?  // error message if failed
  planId    String?
  claimOwner String?
  createdAt DateTime @default(now())

  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
}

model CacheEntry {
  id        Int      @id @default(autoincrement())
  type      String   // "cover" | "screenshot" | "artwork"
  sourceUrl String
  localPath String   // relative path: "covers/123.jpg"
  fileSize  Int      // bytes
  gameId    Int
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([gameId, sourceUrl])
  @@index([sourceUrl])
}

model ApiCache {
  id        Int      @id @default(autoincrement())
  cacheKey  String   @unique
  response  String   // JSON-encoded API response
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// Local processes coordinate using the same SQLite file. Owners are opaque UUIDs.
model JobLease {
  resource  String @id
  owner     String
  expiresAt BigInt

  @@index([expiresAt])
}

model ProviderWindow {
  key       String @id
  used      Int
  expiresAt BigInt

  @@index([expiresAt])
}

model AdmissionClock {
  id    Int    @id
  value BigInt
}

// Physical entries are independent of the catalog's deduplicated representative.
model DeviceFile {
  id            Int      @id @default(autoincrement())
  deviceId      Int
  gameId        Int?
  path          String
  scanRoot      String
  platformAlias String
  relativePath  String
  platform      String?
  source        String
  kind          String
  size          BigInt
  modifiedAt    String?
  sha256        String?
  generation    String
  seenAt        DateTime @default(now())
  device        Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  game          Game?    @relation(fields: [gameId], references: [id], onDelete: SetNull)
  integrityResults IntegrityResult[]

  @@unique([deviceId, path])
  @@index([gameId, deviceId])
  @@index([deviceId, generation])
}

model DeviceInventory {
  deviceId      Int      @id
  generation    String
  complete      Boolean
  scannedAt     DateTime @default(now())
  device        Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

// Journals deliberately have no cascading device/game foreign keys: deleting
// a catalog entry must not discard recovery instructions or verified backups.
model FilePlan {
  id            String   @id @default(uuid())
  kind          String
  status        String   @default("ready")
  deviceState   String
  totalBytes    BigInt
  owner         String?
  revision      Int      @default(0)
  error         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  appliedAt     DateTime?
  operations    FilePlanOperation[]

  @@index([status, createdAt])
}

model FilePlanOperation {
  id            String   @id @default(uuid())
  planId        String
  ordinal       Int
  kind          String
  specification String
  phase         String   @default("planned")
  error         String?
  updatedAt     DateTime @updatedAt
  plan          FilePlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@unique([planId, ordinal])
}

model DoctorReport {
  id        String   @id @default(uuid())
  deviceId  Int
  complete  Boolean
  findings  String
  summary   String
  createdAt DateTime @default(now())

  @@index([deviceId, createdAt])
}

model DatSource {
  id          String   @id @default(uuid())
  name        String
  format      String
  roms        String
  contentHash String   @unique
  createdAt   DateTime @default(now())
}

model IntegrityJob {
  id              String   @id @default(uuid())
  deviceId        Int
  datSourceId     String?
  status          String
  progress        Int      @default(0)
  total           Int      @default(0)
  checked         Int      @default(0)
  cancelRequested Boolean  @default(false)
  owner           String?
  globalOwner     String?
  error           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  completedAt     DateTime?
  results         IntegrityResult[]

  @@index([deviceId, createdAt])
}

model IntegrityResult {
  id                 Int          @id @default(autoincrement())
  jobId              String
  deviceFileId       Int?
  deviceId           Int
  path               String
  fingerprint        String
  observedModifiedAt String?
  datSourceId        String?
  expectedRom        String?
  status             String
  matches            String
  matchCount         Int          @default(0)
  createdAt          DateTime     @default(now())
  job                IntegrityJob @relation(fields: [jobId], references: [id], onDelete: Restrict)
  file               DeviceFile?  @relation(fields: [deviceFileId], references: [id], onDelete: SetNull)

  @@index([jobId, id])
  @@index([deviceFileId, createdAt])
}

model DeviceProfile {
  deviceId     Int      @id
  template     String
  romRoots     String
  saveRoots    String
  formats      String
  reserveBytes BigInt
  updatedAt    DateTime @updatedAt
  device       Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

model DeviceSyncBaseline {
  id             String   @id @default(uuid())
  masterDeviceId Int
  deviceId       Int
  fileKey        String
  masterPath     String
  devicePath     String
  fingerprint    String
  updatedAt      DateTime @updatedAt

  @@unique([masterDeviceId, deviceId, fileKey])
}

model DeviceSyncPlan {
  id             String   @id @default(uuid())
  masterDeviceId Int
  deviceId       Int
  direction      String
  status         String
  plans          String
  conflicts      String
  summary        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([deviceId, createdAt])
}

// Immutable backup metadata has no cascading catalog/device relationship.
model SaveVersion {
  id          String   @id @default(uuid())
  deviceId    Int?
  gameId      Int?
  deviceName  String
  gameTitle   String?
  platform    String?
  fileKey     String
  sourcePath  String
  sha256      String
  size        BigInt
  storageKey  String
  createdAt   DateTime @default(now())

  @@index([gameId, createdAt])
  @@index([deviceId, fileKey, createdAt])
}

model SaveSyncBaseline {
  id             String   @id @default(uuid())
  masterDeviceId Int
  deviceId       Int
  fileKey        String
  masterPath     String
  devicePath     String
  fingerprint    String
  updatedAt      DateTime @updatedAt

  @@unique([masterDeviceId, deviceId, fileKey])
}

model SaveSyncPlan {
  id             String   @id @default(uuid())
  masterDeviceId Int
  deviceId       Int
  direction      String
  status         String
  plans          String
  conflicts      String
  summary        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([deviceId, createdAt])
}

// Positive, server-created upload source references; never user-provided paths.
model UploadFileSource {
  id         String   @id @default(uuid())
  sessionId  String
  path       String
  filename   String
  platform   String
  sha256     String
  size       BigInt
  identity   String
  modifiedAt String?
  released   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([sessionId, createdAt])
}
